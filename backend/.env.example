JWT_SECRET=change-me
MONGO_URL=
MONGODB_URI=
DB_NAME=paws_whiskers
ADMIN_EMAIL=
ADMIN_PASSWORD=
PRODUCTION_URL=https://pawsandwhiskers.in
EMERGENT_EMAIL_KEY=

# Required in production so login OTP is texted to the number entered.
# Fast2SMS (recommended for Indian OTP): https://www.fast2sms.com
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
# FAST2SMS_ROUTE=otp

# TWOFACTOR_API_KEY=
# TWOFACTOR_TEMPLATE=OTP

# MSG91_AUTH_KEY=
# This is the MSG91 OTP template ID, not the DLT template/entity ID. The MSG91
# template must contain the ##OTP## placeholder and be mapped to an approved
# Indian DLT sender/template. Leave MSG91_SENDER_ID empty unless it is exactly
# the sender configured on that MSG91 OTP template.
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ALLOW_DEV_OTP=true  # removed — mobile OTP always sends real SMS when configured
