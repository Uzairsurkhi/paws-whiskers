{
  "name": "Paws & Whiskers India",
  "install": "bash .cursor/scripts/install.sh",
  "start": "bash .cursor/scripts/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && python3 -m uvicorn server:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && yarn start"
    }
  ],
  "ports": [3000, 8000]
}
